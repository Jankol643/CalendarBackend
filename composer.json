{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "guzzlehttp/guzzle": "^7.2",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.24",
        "laravel/tinker": "^2.9",
        "laravel/ui": "^4.5",
        "league/csv": "^9.27",
        "php-open-source-saver/jwt-auth": "^2.8.3",
        "rarst/phpcs-cognitive-complexity": "^0.2.0",
        "socialiteproviders/google": "^4.1",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.4.4",
        "php-parallel-lint/php-parallel-lint": "*",
        "phpunit/phpunit": "^9.5.10",
        "slevomat/coding-standard": "^8.22",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "bootstrap.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoload-dump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "check": "phpcs -d memory_limit=-1 --standard=custom_ruleset.xml -p .",
        "cog-complexity": "./vendor/bin/phpcs --standard=CognitiveComplexity",
        "fix": [
            "Composer\\Config::disableProcessTimeout",
            "phpcbf -d memory_limit=-1 --standard=custom_ruleset.xml -p ."
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
